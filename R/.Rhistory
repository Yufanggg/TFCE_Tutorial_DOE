## Step 2: Observed TFCE map
## ==========================================================
cat("Step 2: Computing observed TFCE map...\n")
TFCE_Obs <- tfce_transform(t_Obs, E  = 0.66, H  = 2, dh = 0.1)
cat("Observed TFCE map completed.\n")
## ==========================================================
## 3. Permutation distribution
## ==========================================================
set.seed(123)
n_perm <- 999
TFCE_permMax <- rep(NaN, n_perm)
subject_info <- designTable %>%
select(Subject, CondCode)
for (p in seq_len(n_perm)) {
perm_info <- subject_info %>%
mutate(CondCode = sample(CondCode))
perm_dat <- EEGlong %>%
left_join(perm_info, by = "Subject") %>%
mutate(
Subject = factor(Subject),
Channel = factor(Channel),
CondCode = as.numeric(CondCode)
)
t_perm <- compute_tmap(perm_dat)
TFCE_perm <- tfce_transform(t_perm)
TFCE_permMax[p] <- max(TFCE_perm)
if (p %% 50 == 0) {
cat("Permutation", p, "of", n_perm, "\n")
}
}
## ==========================================================
## 4. TFCE-corrected p-values
## ==========================================================
## ==========================================================
## Step 4: TFCE-corrected significance
## ==========================================================
cat("Step 4: Computing TFCE-corrected significance...\n")
alpha <- 0.05
nPerm <- length(TFCE_permMax)
maxTFCE <- sort(c(TFCE_permMax, max(abs(TFCE_Obs), na.rm = TRUE)))
maxTFCEcrit <- maxTFCE[round(nPerm * (1 - alpha))]
Mask <- abs(TFCE_Obs) >= maxTFCEcrit
P_Values <- matrix(
NA_real_,
nrow = nrow(TFCE_Obs),
ncol = ncol(TFCE_Obs),
dimnames = dimnames(TFCE_Obs)
)
for (ch in seq_len(n_chan)) {
for (t in seq_len(n_time)) {
P_Values[ch, t] <-
(sum(TFCE_permMax >= abs(TFCE_Obs[ch, t]), na.rm = TRUE) + 1) /
(nPerm + 1)
}
}
cat("TFCE-corrected significance completed.\n")
cat(sprintf("Critical TFCE value = %.4f\n", maxTFCEcrit))
## ==========================================================
## Step 5: Store results
## ==========================================================
cat("Step 5: Storing results...\n")
Results <- list(
tObs         = t_Obs,
TFCE_Obs     = TFCE_Obs,
TFCE_Null    = TFCE_permMax,
maxTFCEcrit  = maxTFCEcrit,
P_Values     = P_Values,
Mask         = Mask,
alpha        = alpha,
nPerm        = nPerm
)
cat("Results stored.\n")
## ==========================================================
## Step 6: Plot TFCE-corrected significant t-values
## ==========================================================
mT <- t_Obs
mT[!Mask] <- 0
plot_eeg_map(
mT,
"TFCE-corrected Group Effect",
times,
nChan
)
## ==========================================================
## TFCE analysis in R for exported between-subject EEG CSV
##
## Input files:
##   ../data/01_designTable.csv
##   ../data/01_EEGdata_long.csv
##
## Model:
##   Amplitude ~ CondCode
##
## Important:
##   This uses permuco:::tfce_distribution()
##   on a flattened Channel ?? Time map.
## ==========================================================
rm(list = ls())
library(dplyr)
library(tidyr)
library(permuco)
source("../R/tfce_transform.R")
source(("../R/plot_eeg_map.R"))
cat("\nStarting TFCE simple between-subject analysis...\n")
## ==========================================================
## -1. Load CSV files
## ==========================================================
designTable <- read.csv("../data/01_designTable.csv")
EEGlong     <- read.csv("../data/01_EEGdata_long.csv")
## Check column names
print(names(designTable))
print(names(EEGlong))
## ==========================================================
## 0. Merge EEG data with design table
## ==========================================================
dat <- EEGlong %>%
left_join(designTable, by = "Subject")
## Make sure condition is numeric contrast
## Expected:
##   CondCode  = -1 control, +1 treatment
dat <- dat %>%
mutate(
Subject = factor(Subject),
Channel = factor(Channel),
CondCode = as.numeric(CondCode)
)
channels <- unique(EEGlong$Channel)
times    <- sort(unique(EEGlong$Time))
nChan <- length(channels)
nTime <- length(times)
## ==========================================================
## -2. Function to compute t-map
## ==========================================================
compute_tmap <- function(data) {
res <- data %>%
group_by(Channel, Time) %>%
summarise(t_value = coef(summary(lm(
Amplitude ~ CondCode
)))["CondCode", "t value"], .groups = "drop")
tmat <- res %>%
mutate(
Channel = factor(Channel, levels = channels),
Time = factor(Time, levels = times)
) %>%
arrange(Channel, Time) %>%
pull(t_value)
matrix(
tmat,
nrow = nChan,
ncol = nTime,
byrow = TRUE,
dimnames = list(channels, times)
)
}
## ==========================================================
## Step 1: Observed t-map
## ==========================================================
cat("Step 1: Computing observed t-map...\n")
t_Obs <- compute_tmap(dat)
cat("Observed t-map completed.\n")
## ==========================================================
## Step 2: Observed TFCE map
## ==========================================================
cat("Step 2: Computing observed TFCE map...\n")
TFCE_Obs <- tfce_transform(t_Obs, E  = 0.66, H  = 2, dh = 0.1)
cat("Observed TFCE map completed.\n")
## ==========================================================
## 3. Permutation distribution
## ==========================================================
set.seed(123)
n_perm <- 999
TFCE_permMax <- rep(NaN, n_perm)
subject_info <- designTable %>%
select(Subject, CondCode)
for (p in seq_len(n_perm)) {
perm_info <- subject_info %>%
mutate(CondCode = sample(CondCode))
perm_dat <- EEGlong %>%
left_join(perm_info, by = "Subject") %>%
mutate(
Subject = factor(Subject),
Channel = factor(Channel),
CondCode = as.numeric(CondCode)
)
t_perm <- compute_tmap(perm_dat)
TFCE_perm <- tfce_transform(t_perm)
TFCE_permMax[p] <- max(TFCE_perm)
if (p %% 50 == 0) {
cat("Permutation", p, "of", n_perm, "\n")
}
}
## ==========================================================
## 4. TFCE-corrected p-values
## ==========================================================
## ==========================================================
## Step 4: TFCE-corrected significance
## ==========================================================
cat("Step 4: Computing TFCE-corrected significance...\n")
alpha <- 0.05
nPerm <- length(TFCE_permMax)
maxTFCE <- sort(c(TFCE_permMax, max(abs(TFCE_Obs), na.rm = TRUE)))
maxTFCEcrit <- maxTFCE[round(nPerm * (1 - alpha))]
Mask <- abs(TFCE_Obs) >= maxTFCEcrit
P_Values <- matrix(
NA_real_,
nrow = nrow(TFCE_Obs),
ncol = ncol(TFCE_Obs),
dimnames = dimnames(TFCE_Obs)
)
for (ch in seq_len(nChan)) {
for (t in seq_len(nTime)) {
P_Values[ch, t] <-
(sum(TFCE_permMax >= abs(TFCE_Obs[ch, t]), na.rm = TRUE) + 1) /
(nPerm + 1)
}
}
cat("TFCE-corrected significance completed.\n")
cat(sprintf("Critical TFCE value = %.4f\n", maxTFCEcrit))
## ==========================================================
## Step 5: Store results
## ==========================================================
cat("Step 5: Storing results...\n")
Results <- list(
tObs         = t_Obs,
TFCE_Obs     = TFCE_Obs,
TFCE_Null    = TFCE_permMax,
maxTFCEcrit  = maxTFCEcrit,
P_Values     = P_Values,
Mask         = Mask,
alpha        = alpha,
nPerm        = nPerm
)
cat("Results stored.\n")
## ==========================================================
## Step 6: Plot TFCE-corrected significant t-values
## ==========================================================
mT <- t_Obs
mT[!Mask] <- 0
plot_eeg_map(
mT,
"TFCE-corrected Group Effect",
times,
nChan
)
plot_eeg_map(
TFCE_Obs,
"TFCE-corrected Significant Effects"
)
plot_eeg_map(
TFCE_Obs,
"TFCE-corrected Significant Effects",
times,
nChan
)
if (!dir.exists("../results")) {
dir.create("../results")
}
save(
Results,
t_Obs,
TFCE_Obs,
TFCE_permMax,
maxTFCEcrit,
P_Values,
Mask,
times,
channels,
file = "../results/01_TFCE_between_subject_results.RData"
)
cat("TFCE analysis completed and results saved.\n")
## ==========================================================
## TFCE for between-subject design with covariate in R
##
## Model:
##   Amplitude ~ Covariate + GroupCode
##
## Test:
##   Group effect adjusted for covariate
##
## Permutation:
##   Freedman-Lane
## ==========================================================
rm(list = ls())
library(readr)
library(dplyr)
library(tidyr)
library(fields)
source("../R/tfce_transform.R")
source("../R/plot_eeg_map.R")
cat("\nStarting TFCE covariate-adjusted analysis...\n")
## ==========================================================
## -1. Load data
## ==========================================================
designTable <- read_csv("../data/02_designTable.csv")
EEGlong     <- read_csv("../data/02_EEGdata_long.csv")
## Check column names
print(names(designTable))
print(names(EEGlong))
## ==========================================================
## 0. Merge EEG data with design table
## ==========================================================
dat <- EEGlong %>%
left_join(designTable, by = "Subject") %>%
mutate(
Subject   = factor(Subject),
Channel   = factor(Channel),
CondCode = as.numeric(CondCode),
Covariate = as.numeric(Covariate)
)
## Make sure condition is numeric contrast
## Expected:
##   CondCode  = -1 control, +1 treatment
channels <- unique(EEGlong$Channel)
times    <- sort(unique(EEGlong$Time))
nChan <- length(channels)
nTime <- length(times)
## ==========================================================
## -2. Function: compute observed/permuted t-map
## ==========================================================
compute_tmap_covariate <- function(data) {
res <- data %>%
group_by(Channel, Time) %>%
summarise(t_value = coef(summary(lm(
Amplitude ~ Covariate + CondCode
)))["CondCode", "t value"], .groups = "drop")
tvec <- res %>%
mutate(
Channel = factor(Channel, levels = channels),
Time    = factor(Time, levels = times)
) %>%
arrange(Channel, Time) %>%
pull(t_value)
matrix(
tvec,
nrow = nChan,
ncol = nTime,
byrow = TRUE,
dimnames = list(channels, times)
)
}
## ==========================================================
## Step 1: Observed t-map
## ==========================================================
cat("Step 1: Computing observed t-map...\n")
t_Obs <- compute_tmap_covariate(dat)
cat("Observed t-map completed.\n")
## ==========================================================
## Step 2: Observed TFCE map
## ==========================================================
cat("Step 2: Computing observed TFCE map...\n")
TFCE_Obs <- tfce_transform(t_Obs, E  = 0.66, H  = 2, dh = 0.1)
cat("Observed TFCE map completed.\n")
## ==========================================================
## Step 3: Freedman-Lane permutation
## ==========================================================
set.seed(123)
nPerm <- 999
TFCE_permMax <- rep(NA_real_, nPerm)
cat("Step 3: Starting Freedman-Lane permutation testing...\n")
## ==========================================================
## Precompute reduced-model fitted values and residuals
## This is done once, before permutation
## ==========================================================
FL_parts <- dat %>%
group_by(Channel, Time) %>%
group_modify( ~ {
df <- .x
lm_red <- lm(Amplitude ~ Covariate, data = df)
df$Y_hat_red <- fitted(lm_red)
df$resid_red <- residuals(lm_red)
df
}) %>%
ungroup()
for (p in seq_len(nPerm)) {
perm_dat <- FL_parts %>%
group_by(Channel, Time) %>%
group_modify( ~ {
df <- .x
perm_idx <- sample(seq_len(length(unique(dat$Subject))))
## Freedman-Lane permuted response
df$Amplitude <- df$Y_hat_red + df$resid_red[perm_idx]
df
}) %>%
ungroup()
t_perm <- compute_tmap_covariate(perm_dat)
TFCE_perm <- tfce_transform(t_perm, E  = 0.66, H  = 2, dh = 0.1)
TFCE_permMax[p] <- max(abs(TFCE_perm), na.rm = TRUE)
if (p %% 50 == 0) {
cat("Permutation", p, "of", nPerm, "\n")
}
}
## ==========================================================
## TFCE for between-subject design with covariate in R
##
## Model:
##   Amplitude ~ Covariate + GroupCode
##
## Test:
##   Group effect adjusted for covariate
##
## Permutation:
##   Freedman-Lane
## ==========================================================
rm(list = ls())
library(readr)
library(dplyr)
library(tidyr)
library(fields)
